# Supabase Public Configuration (Exposed to Browser via Next.js NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Secret (NEVER prefix with NEXT_PUBLIC_ / NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Portal Configuration Defaults
NEXT_PUBLIC_PORTAL_NAME=PCSK School Web Portal
NEXT_PUBLIC_DEFAULT_INACTIVITY_TIMEOUT_MINUTES=30
